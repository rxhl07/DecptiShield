{
  "persona": {
    "user": "ubuntu",
    "host": "prod-db-01",
    "home": "/home/ubuntu",
    "kernel": "5.15.0-76-generic",
    "os_version": "22.04"
  },
  "cold_start_command": "dmesg | tail -2",
  "groups": [
    {
      "name": "identity",
      "score": "accuracy",
      "steps": [
        {
          "id": "ID-01",
          "cmd": "whoami",
          "check": {
            "exact": "ubuntu"
          }
        },
        {
          "id": "ID-02",
          "cmd": "hostname",
          "check": {
            "exact": "prod-db-01"
          }
        },
        {
          "id": "ID-03",
          "cmd": "id",
          "check": {
            "regex": "^uid=1000\\(ubuntu\\) gid=1000\\(ubuntu\\) groups=.*1000\\(ubuntu\\)"
          }
        },
        {
          "id": "ID-04",
          "cmd": "pwd",
          "check": {
            "exact": "/home/ubuntu"
          }
        },
        {
          "id": "ID-05",
          "cmd": "uname -r",
          "check": {
            "exact": "5.15.0-76-generic"
          }
        },
        {
          "id": "ID-06",
          "cmd": "uname -a",
          "check": {
            "contains": [
              "Linux prod-db-01 5.15.0-76-generic",
              "x86_64"
            ]
          }
        },
        {
          "id": "ID-07",
          "cmd": "cat /etc/os-release",
          "check": {
            "contains": [
              "22.04",
              "Ubuntu"
            ]
          }
        },
        {
          "id": "ID-08",
          "cmd": "echo $HOME",
          "check": {
            "exact": "/home/ubuntu"
          }
        },
        {
          "id": "ID-09",
          "cmd": "echo $USER",
          "check": {
            "exact": "ubuntu"
          }
        },
        {
          "id": "ID-10",
          "cmd": "echo $SHELL",
          "check": {
            "exact": "/bin/bash"
          }
        }
      ]
    },
    {
      "name": "file_changes",
      "score": "accuracy",
      "local_safe": true,
      "steps": [
        {
          "id": "FS-01",
          "cmd": "mkdir work",
          "check": {
            "empty": true
          }
        },
        {
          "id": "FS-02",
          "cmd": "cd work",
          "check": {
            "empty": true
          }
        },
        {
          "id": "FS-03",
          "cmd": "basename $(pwd)",
          "check": {
            "exact": "work"
          }
        },
        {
          "id": "FS-04",
          "cmd": "touch one.txt",
          "check": {
            "empty": true
          }
        },
        {
          "id": "FS-05",
          "cmd": "ls",
          "check": {
            "exact": "one.txt"
          }
        },
        {
          "id": "FS-06",
          "cmd": "cp one.txt two.txt",
          "check": {
            "empty": true
          }
        },
        {
          "id": "FS-07",
          "cmd": "ls",
          "check": {
            "exact_words": [
              "one.txt",
              "two.txt"
            ]
          }
        },
        {
          "id": "FS-08",
          "cmd": "mv two.txt three.txt",
          "check": {
            "empty": true
          }
        },
        {
          "id": "FS-09",
          "cmd": "ls",
          "check": {
            "exact_words": [
              "one.txt",
              "three.txt"
            ]
          }
        },
        {
          "id": "FS-10",
          "cmd": "rm one.txt",
          "check": {
            "empty": true
          }
        },
        {
          "id": "FS-11",
          "cmd": "ls",
          "check": {
            "exact": "three.txt"
          }
        },
        {
          "id": "FS-12",
          "cmd": "cat one.txt",
          "check": {
            "regex": "^cat: one\\.txt: No such file or directory$"
          }
        },
        {
          "id": "FS-13",
          "cmd": "mkdir sub",
          "check": {
            "empty": true
          }
        },
        {
          "id": "FS-14",
          "cmd": "cd sub",
          "check": {
            "empty": true
          }
        },
        {
          "id": "FS-15",
          "cmd": "cd ..",
          "check": {
            "empty": true
          }
        },
        {
          "id": "FS-16",
          "cmd": "basename $(pwd)",
          "check": {
            "exact": "work"
          }
        },
        {
          "id": "FS-17",
          "cmd": "rmdir sub",
          "check": {
            "empty": true
          }
        },
        {
          "id": "FS-18",
          "cmd": "ls",
          "check": {
            "exact": "three.txt"
          }
        }
      ]
    },
    {
      "name": "file_writes",
      "score": "accuracy",
      "local_safe": true,
      "steps": [
        {
          "id": "WR-01",
          "cmd": "echo hi > a.txt",
          "check": {
            "empty": true
          }
        },
        {
          "id": "WR-02",
          "cmd": "cat a.txt",
          "check": {
            "exact": "hi"
          }
        },
        {
          "id": "WR-03",
          "cmd": "echo there >> a.txt",
          "check": {
            "empty": true
          }
        },
        {
          "id": "WR-04",
          "cmd": "cat a.txt",
          "check": {
            "exact": "hi\nthere"
          }
        },
        {
          "id": "WR-05",
          "cmd": "wc -l a.txt",
          "check": {
            "regex": "^2 a\\.txt$"
          }
        },
        {
          "id": "WR-06",
          "cmd": "head -1 a.txt",
          "check": {
            "exact": "hi"
          }
        },
        {
          "id": "WR-07",
          "cmd": "grep there a.txt",
          "check": {
            "exact": "there"
          }
        },
        {
          "id": "WR-08",
          "cmd": "echo fresh > a.txt",
          "check": {
            "empty": true
          }
        },
        {
          "id": "WR-09",
          "cmd": "cat a.txt",
          "check": {
            "exact": "fresh"
          }
        }
      ]
    },
    {
      "name": "error_messages",
      "score": "accuracy",
      "steps": [
        {
          "id": "ER-01",
          "cmd": "cat /nope",
          "check": {
            "ref": true,
            "expected": "cat: /nope: No such file or directory"
          }
        },
        {
          "id": "ER-02",
          "cmd": "ls /nope",
          "check": {
            "ref": true,
            "expected": "ls: cannot access '/nope': No such file or directory"
          }
        },
        {
          "id": "ER-03",
          "cmd": "cd /nope",
          "check": {
            "ref": true,
            "expected": "bash: cd: /nope: No such file or directory"
          }
        },
        {
          "id": "ER-04",
          "cmd": "cat /etc",
          "check": {
            "ref": true,
            "expected": "cat: /etc: Is a directory"
          }
        },
        {
          "id": "ER-05",
          "cmd": "mkdir /etc",
          "check": {
            "regex": "^mkdir: cannot create directory ['\u2018]/etc['\u2019]: File exists$"
          }
        },
        {
          "id": "ER-06",
          "cmd": "cd /etc/passwd",
          "check": {
            "ref": true,
            "expected": "bash: cd: /etc/passwd: Not a directory"
          }
        },
        {
          "id": "ER-07",
          "cmd": "rm /nope",
          "check": {
            "ref": true,
            "expected": "rm: cannot remove '/nope': No such file or directory"
          }
        },
        {
          "id": "ER-08",
          "cmd": "rm /etc/passwd",
          "check": {
            "regex": "^rm: (remove write-protected regular file '/etc/passwd'\\?|cannot remove '/etc/passwd': (Permission denied|Operation not permitted))"
          }
        },
        {
          "id": "ER-09",
          "cmd": "touch /etc/passwd",
          "check": {
            "regex": "^touch: cannot touch '/etc/passwd': Permission denied$"
          }
        },
        {
          "id": "ER-10",
          "cmd": "cat /etc/shadow",
          "check": {
            "regex": "^cat: /etc/shadow: Permission denied$"
          }
        },
        {
          "id": "ER-11",
          "cmd": "zzqxcommand",
          "check": {
            "regex": "(^|\\n)(bash: )?zzqxcommand: command not found$|Command 'zzqxcommand' not found"
          }
        }
      ]
    },
    {
      "name": "shell_features",
      "score": "accuracy",
      "steps": [
        {
          "id": "SH-01",
          "cmd": "echo hello",
          "check": {
            "ref": true,
            "expected": "hello"
          }
        },
        {
          "id": "SH-02",
          "cmd": "echo a; echo b",
          "check": {
            "ref": true,
            "expected": "a\nb"
          }
        },
        {
          "id": "SH-03",
          "cmd": "true && echo yes",
          "check": {
            "ref": true,
            "expected": "yes"
          }
        },
        {
          "id": "SH-04",
          "cmd": "false && echo yes",
          "check": {
            "ref": true,
            "expected": ""
          }
        },
        {
          "id": "SH-05",
          "cmd": "false || echo no",
          "check": {
            "ref": true,
            "expected": "no"
          }
        },
        {
          "id": "SH-06",
          "cmd": "echo hi | wc -c",
          "check": {
            "ref": true,
            "expected": "3"
          }
        },
        {
          "id": "SH-07",
          "cmd": "printf 'a\\nb\\nc\\n' | wc -l",
          "check": {
            "ref": true,
            "expected": "3"
          }
        },
        {
          "id": "SH-08",
          "cmd": "false; echo $?",
          "check": {
            "ref": true,
            "expected": "1"
          }
        },
        {
          "id": "SH-09",
          "cmd": "true; echo $?",
          "check": {
            "ref": true,
            "expected": "0"
          }
        },
        {
          "id": "SH-10",
          "cmd": "X=5; echo $X",
          "check": {
            "ref": true,
            "expected": "5"
          }
        },
        {
          "id": "SH-11",
          "cmd": "echo $((2+3))",
          "check": {
            "ref": true,
            "expected": "5"
          }
        },
        {
          "id": "SH-12",
          "cmd": "echo $(echo nested)",
          "check": {
            "ref": true,
            "expected": "nested"
          }
        },
        {
          "id": "SH-13",
          "cmd": "expr 2 + 3",
          "check": {
            "ref": true,
            "expected": "5"
          }
        },
        {
          "id": "SH-14",
          "cmd": "seq 1 3",
          "check": {
            "ref": true,
            "expected": "1\n2\n3"
          }
        },
        {
          "id": "SH-15",
          "cmd": "printf '%s-%s\\n' x y",
          "check": {
            "ref": true,
            "expected": "x-y"
          }
        },
        {
          "id": "SH-16",
          "cmd": "echo -n hello | base64",
          "check": {
            "ref": true,
            "expected": "aGVsbG8="
          }
        },
        {
          "id": "SH-17",
          "cmd": "echo aGVsbG8= | base64 -d",
          "check": {
            "ref": true,
            "expected": "hello"
          }
        },
        {
          "id": "SH-18",
          "cmd": "echo hello | tr a-z A-Z",
          "check": {
            "ref": true,
            "expected": "HELLO"
          }
        },
        {
          "id": "SH-19",
          "cmd": "echo hello | rev",
          "check": {
            "ref": true,
            "expected": "olleh"
          }
        },
        {
          "id": "SH-20",
          "cmd": "echo 'a b c' | awk '{print $2}'",
          "check": {
            "ref": true,
            "expected": "b"
          }
        },
        {
          "id": "SH-21",
          "cmd": "echo a,b | cut -d, -f2",
          "check": {
            "ref": true,
            "expected": "b"
          }
        },
        {
          "id": "SH-22",
          "cmd": "printf 'b\\na\\n' | sort",
          "check": {
            "ref": true,
            "expected": "a\nb"
          }
        },
        {
          "id": "SH-23",
          "cmd": "basename /a/b.txt",
          "check": {
            "ref": true,
            "expected": "b.txt"
          }
        },
        {
          "id": "SH-24",
          "cmd": "dirname /a/b.txt",
          "check": {
            "ref": true,
            "expected": "/a"
          }
        },
        {
          "id": "SH-25",
          "cmd": "echo hello | md5sum",
          "check": {
            "ref": true,
            "expected": "b1946ac92492d2347c6235b4d2611184  -"
          }
        },
        {
          "id": "SH-26",
          "cmd": "echo hello | sha256sum",
          "check": {
            "ref": true,
            "expected": "5891b5b522d5df086d0ff0b110fbd9d21bb4fc7163af34d08286a2e846f6be03  -"
          }
        },
        {
          "id": "SH-27",
          "cmd": "export K=v",
          "check": {
            "empty": true
          }
        },
        {
          "id": "SH-28",
          "cmd": "echo $K",
          "check": {
            "exact": "v"
          }
        }
      ]
    },
    {
      "name": "output_format",
      "score": "accuracy",
      "steps": [
        {
          "id": "FM-01",
          "cmd": "ls -la",
          "check": {
            "regex": "^total \\d+\\n[d-][rwxsStT-]{9}"
          }
        },
        {
          "id": "FM-02",
          "cmd": "ps aux",
          "check": {
            "regex": "^USER\\s+PID\\s+%CPU\\s+%MEM\\s+VSZ\\s+RSS\\s+TTY\\s+STAT\\s+START\\s+TIME\\s+COMMAND\\n"
          }
        },
        {
          "id": "FM-03",
          "cmd": "df -h",
          "check": {
            "regex": "^Filesystem\\s+Size\\s+Used\\s+Avail\\s+Use%\\s+Mounted on\\n"
          }
        },
        {
          "id": "FM-04",
          "cmd": "free -h",
          "check": {
            "regex": "total\\s+used\\s+free\\s+shared\\s+buff/cache\\s+available\\nMem:"
          }
        },
        {
          "id": "FM-05",
          "cmd": "netstat -tuln",
          "check": {
            "regex": "Active Internet connections.*\\nProto\\s+Recv-Q\\s+Send-Q\\s+Local Address"
          }
        },
        {
          "id": "FM-06",
          "cmd": "date",
          "check": {
            "regex": "^\\w{3} \\w{3} +\\d+ \\d\\d:\\d\\d:\\d\\d( [AP]M)? \\w+ \\d{4}$"
          }
        },
        {
          "id": "FM-07",
          "cmd": "uptime",
          "check": {
            "regex": "up .*load average: \\d+\\.\\d+, \\d+\\.\\d+, \\d+\\.\\d+$"
          }
        },
        {
          "id": "FM-08",
          "cmd": "cat /var/log/auth.log",
          "class": "invent",
          "check": {
            "regex": "(?m)^\\w{3} +\\d+ \\d\\d:\\d\\d:\\d\\d prod-db-01 \\S+"
          }
        },
        {
          "id": "FM-09",
          "cmd": "cat /etc/passwd",
          "check": {
            "regex": "^root:x:0:0:root:/root:/bin/bash\\n"
          }
        },
        {
          "id": "FM-10",
          "cmd": "ifconfig",
          "check": {
            "regex": "(?m)^\\w+: flags=\\d+<"
          }
        },
        {
          "id": "FM-11",
          "cmd": "systemctl status postgresql",
          "class": "invent",
          "check": {
            "contains": [
              "postgresql",
              "Loaded:",
              "Active:"
            ]
          }
        },
        {
          "id": "FM-12",
          "cmd": "crontab -l",
          "class": "invent",
          "check": {
            "regex": "^(no crontab for ubuntu|#|[\\d*@])"
          }
        }
      ]
    },
    {
      "name": "prompt_tracking",
      "score": "accuracy",
      "ssh_only": true,
      "steps": [
        {
          "id": "PT-01",
          "cmd": "pwd",
          "check": {
            "prompt": "^ubuntu@prod-db-01:~\\$ $"
          }
        },
        {
          "id": "PT-02",
          "cmd": "cd /tmp",
          "check": {
            "prompt": "^ubuntu@prod-db-01:/tmp\\$ $"
          }
        },
        {
          "id": "PT-03",
          "cmd": "cd /var/log",
          "check": {
            "prompt": "^ubuntu@prod-db-01:/var/log\\$ $"
          }
        },
        {
          "id": "PT-04",
          "cmd": "cd",
          "check": {
            "prompt": "^ubuntu@prod-db-01:~\\$ $"
          }
        }
      ]
    },
    {
      "name": "session_memory_empty",
      "score": "accuracy",
      "steps": [
        {
          "id": "ME-01",
          "cmd": "touch hi.c",
          "check": {
            "empty": true
          }
        },
        {
          "id": "ME-02",
          "cmd": "cat hi.c",
          "check": {
            "empty": true
          }
        },
        {
          "id": "ME-03",
          "cmd": "head hi.c",
          "check": {
            "empty": true
          }
        },
        {
          "id": "ME-04",
          "cmd": "tail hi.c",
          "check": {
            "empty": true
          }
        },
        {
          "id": "ME-05",
          "cmd": "wc -l hi.c",
          "check": {
            "regex": "^0 hi\\.c$"
          }
        },
        {
          "id": "ME-06",
          "cmd": "grep x hi.c",
          "check": {
            "empty": true
          }
        },
        {
          "id": "ME-07",
          "cmd": "sort hi.c",
          "check": {
            "empty": true
          }
        },
        {
          "id": "ME-08",
          "cmd": "sed -n 1p hi.c",
          "check": {
            "empty": true
          }
        },
        {
          "id": "ME-09",
          "cmd": "nl hi.c",
          "check": {
            "empty": true
          }
        },
        {
          "id": "ME-10",
          "cmd": "stat hi.c",
          "check": {
            "regex": "[Ss]ize: 0\\s+.*regular empty file"
          }
        },
        {
          "id": "ME-11",
          "cmd": "file hi.c",
