            "exact": "hi.c: empty"
          }
        },
        {
          "id": "ME-12",
          "cmd": "ls -l hi.c",
          "check": {
            "regex": "^-rw-[r-]{2}-.* 0 .* hi\\.c$"
          }
        },
        {
          "id": "ME-13",
          "cmd": "du hi.c",
