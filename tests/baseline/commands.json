          }
        },
        {
          "id": "ME-15",
          "cmd": "./hi.c",
          "check": {
            "regex": "\\./hi\\.c: Permission denied$"
          }
        },
        {
          "id": "ME-16",
          "cmd": "bash hi.c",
          "check": {
            "empty": true
          }
        },
        {
          "id": "ME-17",
          "cmd": "cat hi.c | wc -l",
          "check": {
            "exact": "0"
          }
        }
      ],
      "local_safe": true
    },
    {
      "name": "session_memory_content",
